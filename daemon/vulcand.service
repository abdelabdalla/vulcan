[Unit]
Description=Vulcan: control this PC from your iPhone
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/vulcand serve
Restart=on-failure
RestartSec=2
# Leave apps started by custom commands running if vulcand restarts.
KillMode=process

[Install]
WantedBy=graphical-session.target
